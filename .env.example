# VirasatPlanner Production Environment Configuration Template
# Copy this file to .env and provide strong, unique secrets.

# Environment mode: 'development', 'test', or 'production'
ENVIRONMENT=development

# Application Secret Key for HMAC token signing and sessions
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Encrypted Vault Encryption Key (Fernet key, 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_SECRET_KEY=

# Database Connection URL (SQLite for local/test, PostgreSQL for production)
DATABASE_URL=sqlite:///data/virasat.db

# Authentication Token Expiry in Hours (default: 24)
AUTH_TOKEN_EXPIRE_HOURS=24

# Allowed Host / CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Groq Cloud API Key for AI Legacy Advisor
GROQ_API_KEY=your_groq_api_key_here
